# InsiteIQ v1 Foundation — Environment template
# Copy to .env and fill real values. .env is gitignored, never commit.

# --- App ---
APP_NAME=InsiteIQ
# En "production" la app FALLA al arrancar si JWT_SECRET_KEY es el placeholder
APP_ENV=development
DEBUG=true

# --- MongoDB ---
# Container-internal hostname inside docker-compose network
MONGO_URL=mongodb://mongo:27017
MONGO_DB=insiteiq
MONGO_INITDB_DATABASE=insiteiq

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE-ME-GENERATE-64-CHARS-SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=480
JWT_REFRESH_EXPIRE_DAYS=7

# --- Rate limiting ---
# Formato slowapi: "N/minute" | "N/hour". Protege /auth/login.
RATE_LIMIT_LOGIN=10/minute

# --- CORS ---
# Solo si necesitas añadir orígenes extra a los defaults de config.py
# CORS_ORIGINS=["https://insiteiq.systemrapid.io"]

# --- Outbox workers (email + webhook) ---
WORKERS_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=30
WORKER_BATCH_SIZE=20
WORKER_MAX_ATTEMPTS=5

# --- SMTP (email worker) ---
# ⚠️ Sin SMTP_HOST el email worker queda en modo NoOp: los emails se
# encolan en email_outbox pero NUNCA se envían (silencioso).
# Ejemplos: smtp-relay.brevo.com · smtp.gmail.com (app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=InsiteIQ <noreply@systemrapid.io>
SMTP_USE_TLS=true

# --- Webhook worker ---
WEBHOOK_TIMEOUT_SECONDS=15
# Si está set: firma HMAC-SHA256 en header X-InsiteIQ-Signature
WEBHOOK_SIGNING_SECRET=

# --- AI (Copilot briefing enrichment · opcional) ---
# disabled (default) | openai
INSITEIQ_AI_PROVIDER=disabled
# OPENAI_API_KEY=sk-...
